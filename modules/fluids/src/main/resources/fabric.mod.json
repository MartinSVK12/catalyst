{
	"schemaVersion": 1,
	"id": "catalyst-fluids",
	"version": "${version}",
	"name": "Catalyst: Fluids",
	"description": "Fluid module of Catalyst: API for better fluid transport and storage.",
	"icon": "icon.png",
	"authors": [
		"sunsetsatellite"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/MartinSVK12/catalyst"
	},
	"license": "MIT",
	"environment": "*",
